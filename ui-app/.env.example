# Copy this file to .env and adjust the value for your environment.
#
# VITE_API_BASE_URL — Full URL of the Quarkus API microservice.
# Leave empty or unset when using Vite dev server (proxy handles /api and /ws).
# Required when serving the built dist/ statically in production.
#
# Examples:
#   VITE_API_BASE_URL=http://localhost:8081
#   VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=http://localhost:8081
