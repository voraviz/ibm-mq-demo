* ================================================
* Channel Definition
* ================================================

DEFINE CHANNEL('DEV.APP.SVRCONN') CHLTYPE(SVRCONN) TRPTYPE(TCP) MCAUSER('app') REPLACE

* ================================================
* Channel Authentication
* ================================================
SET CHLAUTH('*') TYPE(ADDRESSMAP) ADDRESS('*') USERSRC(NOACCESS) ACTION(REPLACE)
SET CHLAUTH('DEV.APP.SVRCONN') TYPE(BLOCKUSER) USERLIST('nobody') ACTION(REPLACE)
SET CHLAUTH('DEV.APP.SVRCONN') TYPE(USERMAP) CLNTUSER('app') MCAUSER('app') ACTION(REPLACE)

* ================================================
* Connection Authentication
* ================================================
ALTER AUTHINFO(SYSTEM.DEFAULT.AUTHINFO.IDPWOS) AUTHTYPE(IDPWOS) CHCKCLNT(REQUIRED) CHCKLOCL(OPTIONAL)
REFRESH SECURITY TYPE(CONNAUTH)

* ================================================
* Object Authority
* ================================================
* Queue Manager connect permission

SET AUTHREC OBJTYPE(QMGR) PRINCIPAL('app') AUTHADD(CONNECT,INQ)

* Grant app full access to all DEV.* queues (single level)
SET AUTHREC PROFILE('DEV.*') OBJTYPE(QUEUE) PRINCIPAL('app') AUTHADD(PUT,GET,INQ,BROWSE)

* Restrict access to dead letter queue — GET only
SET AUTHREC PROFILE('DEV.DEAD') OBJTYPE(QUEUE) PRINCIPAL('app') AUTHADD(GET,INQ,BROWSE)
SET AUTHREC PROFILE('DEV.DEAD') OBJTYPE(QUEUE) PRINCIPAL('app') AUTHRMV(PUT)

* Channel access
SET AUTHREC PROFILE('DEV.APP.SVRCONN') OBJTYPE(CHANNEL) PRINCIPAL('app') AUTHADD(ALL)

* ================================================
* Uniform Cluster — QM2
* ================================================
* Cluster Receiver — advertise all 3 HA nodes so cluster
* channels survive Native HA failover within this group
DEFINE CHANNEL('UNIQA.QM2') CHLTYPE(CLUSRCVR) TRPTYPE(TCP) +
  CONNAME('mq-node-4(1414),mq-node-5(1414),mq-node-6(1414)') +
  CLUSTER('UNIQA') REPLACE

* Cluster Sender — seed connection to QM2
* Only needed for bootstrap — AutoCluster maintains it after
DEFINE CHANNEL('UNIQA.QM1') CHLTYPE(CLUSSDR) TRPTYPE(TCP) +
  CONNAME('mq-node-1(1414),mq-node-2(1414),mq-node-3(1414)') +
  CLUSTER('UNIQA') REPLACE

* ================================================
* Cluster Queues — identical definition on both QMs
* DEFBIND(NOTFIXED) enables MQ to distribute messages
* across all QMs rather than pinning to one
* ================================================

DEFINE QLOCAL('DEV.DEMO.QL.IN') CLUSTER('UNIQA') DEFBIND(NOTFIXED) DEFPSIST(YES) REPLACE
DEFINE QLOCAL('DEV.DEMO.QL.OUT') CLUSTER('UNIQA') DEFBIND(NOTFIXED) DEFPSIST(YES) REPLACE
DEFINE QLOCAL('DEV.DEMO.QL.DEAD') CLUSTER('UNIQA') DEFBIND(NOTFIXED) DEFPSIST(YES) REPLACE