* Channel for client connections
DEFINE CHANNEL('DEV.APP.SVRCONN') CHLTYPE(SVRCONN) TRPTYPE(TCP) MCAUSER('mqm') REPLACE

* Test queue
* BOTHRESH + BOQNAME give transacted consumers a poison-message escape: after 5
* failed redeliveries MQ moves the message to the backout queue instead of looping forever.
DEFINE QLOCAL('DEV.DEMO.QL.IN') DEFPSIST(YES) BOTHRESH(5) BOQNAME('DEV.DEMO.QL.BACKOUT') REPLACE
DEFINE QLOCAL('DEV.DEMO.QL.BACKOUT') DEFPSIST(YES) REPLACE

* Allow anonymous adccess for dev/test
SET CHLAUTH('DEV.APP.SVRCONN') TYPE(BLOCKUSER) USERLIST('nobody')
ALTER AUTHINFO(SYSTEM.DEFAULT.AUTHINFO.IDPWOS) AUTHTYPE(IDPWOS) CHCKCLNT(NONE)
REFRESH SECURITY TYPE(CONNAUTH)
